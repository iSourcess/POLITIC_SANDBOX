<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <!-- Círculo exterior -->
  <circle cx="16" cy="16" r="15" fill="#f0f0f0" stroke="#333" stroke-width="1"/>
  
  <!-- Caja (sandbox) -->
  <g transform="translate(8, 8) scale(0.06)">
    <!-- Base de la caja -->
    <path d="M100,100 L200,150 L100,200 L0,150 Z" fill="#f0f0f0" stroke="#000" stroke-width="12"/>
    
    <!-- Lados de la caja -->
    <path d="M0,150 L0,100 L100,50 L200,100 L200,150" fill="#f0f0f0" stroke="#000" stroke-width="12"/>
    
    <!-- Líneas internas -->
    <path d="M100,50 L100,200" fill="#f0f0f0" stroke="#000" stroke-width="12"/>
    <path d="M0,100 L100,150 L200,100" fill="#f0f0f0" stroke="#000" stroke-width="12"/>
  </g>
  
  <!-- Iniciales PS -->
  <text x="10" y="20" font-family="Arial, sans-serif" font-size="6" font-weight="bold" fill="#333">PS</text>
</svg>